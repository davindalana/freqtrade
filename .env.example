# ==========================================================
# BINANCE FUTURES API CREDENTIALS TEMPLATE (.env.example)
# Salin file ini menjadi .env lalu isi kredensial akun Anda:
# cp .env.example .env
# ==========================================================
FREQTRADE__EXCHANGE__KEY=your_binance_api_key_here
FREQTRADE__EXCHANGE__API_KEY=your_binance_api_key_here
FREQTRADE__EXCHANGE__SECRET=your_binance_secret_here

# Web UI Credentials
FREQTRADE__API_SERVER__PASSWORD=your_web_ui_password_here
FREQTRADE__API_SERVER__JWT_SECRET_KEY=your_random_jwt_secret_here
